{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hawi",
  "version": "0.1.0",
  "identifier": "com.hawi.gui",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hawi",
        "width": 1160,
        "height": 780,
        "minWidth": 840,
        "minHeight": 560,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "resources": {
      "../build/bin/hawi-engine": "bin/hawi-engine"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
