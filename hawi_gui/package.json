{
  "name": "hawi-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Shadcn-style desktop GUI for Hawi core-cli",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:renderer": "vite build",
    "build:core": "node scripts/build-python-core.mjs",
    "build:all": "npm run build:core && npm run build",
    "install:preflight": "node scripts/install-preflight.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420",
    "run": "electron .",
    "start": "node scripts/start-desktop.mjs",
    "start:tauri": "node scripts/run-tauri.mjs dev",
    "start:electron": "electron .",
    "dev": "node scripts/start-desktop.mjs",
    "dev:tauri": "node scripts/run-tauri.mjs dev",
    "dev:electron": "npm run build && npm run start:electron",
    "dev:fast": "tsc -p tsconfig.node.json && vite build && npm run start:electron",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "npm run build:core && node scripts/run-tauri.mjs build",
    "package": "npm run package:tauri",
    "package:tauri": "npm run tauri:build",
    "package:electron": "npm run build:all && electron-builder --dir",
    "release:local": "node scripts/release-local.mjs",
    "dist": "npm run dist:tauri",
    "dist:tauri": "npm run tauri:build",
    "dist:electron": "npm run build:all && electron-builder",
    "dist:mac": "npm run dist:tauri",
    "dist:win": "npm run dist:tauri",
    "dist:linux": "npm run dist:tauri",
    "dist:mac:electron": "npm run build:all && electron-builder --mac",
    "dist:win:electron": "npm run build:all && electron-builder --win",
    "dist:linux:electron": "npm run build:all && electron-builder --linux",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.561.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "com.hawi.gui",
    "productName": "Hawi",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bin/hawi-engine",
        "to": "bin/hawi-engine"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src-tauri/icons/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src-tauri/icons/icon.ico",
      "signExts": [
        "!.exe",
        "!.dll",
        "!.node"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src-tauri/icons/icon.png",
      "category": "Utility"
    }
  }
}
