{
  "name": "hawi-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Electron GUI for Hawi core-cli",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dev:fast": "tsc -p tsconfig.node.json && vite build && electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.561.0",
    "markdown-it": "^14.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
